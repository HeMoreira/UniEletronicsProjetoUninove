@page
@model RastreioModel
@{
    ViewData["Title"] = "Rastreio";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/rastreio.css" asp-append-version="true" />
}

<div class="rastreio-page">
    <section class="rastreio-intro">
        <a class="back-link" asp-page="/Pedidos"><i class="fa-solid fa-arrow-left"></i> Voltar para pedidos</a>
        <h1>Consulte seu produto</h1>
        <p>Digite o ID do produto para consultar as informações cadastradas no banco de dados UniEletronics.</p>
    </section>

    <section class="tracking-search-card">
        <div class="search-heading">
            <span class="search-icon"><i class="fa-solid fa-box"></i></span>
            <div><h2>Consulta por ID</h2><p>O resultado exibirá os dados do produto que corresponde ao ID informado.</p></div>
        </div>
        <form method="post" class="tracking-search-form">
            <label for="ProdutoId">ID do produto</label>
            <div class="search-controls">
                <input asp-for="ProdutoId" id="ProdutoId" class="tracking-input" type="number" min="1" step="1" placeholder="Ex.: 12" autocomplete="off" required />
                <button type="submit" class="tracking-button"><i class="fa-solid fa-magnifying-glass"></i> Consultar</button>
            </div>
        </form>
    </section>

    @if (Model.MostrarResultado)
    {
        @if (Model.ProdutoEncontrado != null)
        {
            var produto = Model.ProdutoEncontrado;
            <section class="tracking-result">
                <div class="result-summary">
                    <div><span class="eyebrow">Produto localizado no cadastro</span><h2>ID #@produto.Id</h2><p>@produto.Nome</p></div>
                    <span class="current-status"><i class="fa-solid fa-database"></i> Dados do banco</span>
                </div>
                <div class="product-data-grid">
                    <div class="product-image-wrap">
                        @if (!string.IsNullOrWhiteSpace(produto.ImagemPrincipal))
                        {
                            // O cadastro salva imagens com caminho absoluto, como /uploads/nome.jpg.
                            var caminhoImagem = produto.ImagemPrincipal.Trim();
                            var imagemUrl = caminhoImagem.StartsWith("~/", StringComparison.Ordinal)
                                ? Url.Content(caminhoImagem)
                                : Url.Content(caminhoImagem.StartsWith("/", StringComparison.Ordinal) ? caminhoImagem : "~/" + caminhoImagem);
                            <img src="@imagemUrl" alt="@produto.Nome" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        }
                        <div class="product-image-fallback" style="display:@(string.IsNullOrWhiteSpace(produto.ImagemPrincipal) ? "flex" : "none")">
                            <i class="fa-solid fa-image"></i><span>Imagem indisponível</span>
                        </div>
                    </div>
                    <div class="product-data">
                        <h2>Dados do produto</h2>
                        <dl>
                            <div><dt>Nome</dt><dd>@produto.Nome</dd></div>
                            <div><dt>ID</dt><dd>@produto.Id</dd></div>
                            <div><dt>Código</dt><dd>@produto.Codigo</dd></div>
                            <div><dt>Categoria</dt><dd>@produto.Categoria</dd></div>
                            <div><dt>Preço</dt><dd>@produto.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</dd></div>
                            <div><dt>Quantidade em estoque</dt><dd>@produto.Quantidade</dd></div>
                            <div><dt>Data de cadastro</dt><dd>@produto.DataDeRegistro.ToString("dd/MM/yyyy")</dd></div>
                        </dl>
                    </div>
                </div>
                <div class="tracking-extra">
                    <div class="extra-icon"><i class="fa-solid fa-circle-info"></i></div>
                    <div><h3>Informações de entrega</h3><p>O banco de dados atual contém o cadastro do produto, mas não possui registros de movimentação ou status de entrega para este item.</p></div>
                </div>
            </section>
        }
        else
        {
            <section class="tracking-error" role="alert"><i class="fa-solid fa-circle-exclamation"></i><p>@Model.MensagemErro</p></section>
        }
    }
    else
    {
        <section class="tracking-help-card">
            <i class="fa-regular fa-circle-question"></i>
            <div><h3>Precisa de ajuda?</h3><p>Confira o ID do produto no cadastro/estoque ou entre em contato com nossa equipe.</p></div>
            <a asp-page="/Estoque">Consultar estoque <i class="fa-solid fa-arrow-right"></i></a>
        </section>
    }
</div>
